  playOnlyOnce: 1
  hasPlayed: 0
  lines:
  - text: "V\xE1\u017Een\xFD, vystupujeme. Kone\u010Dn\xE1 ! Kone\u010Dn\xE1 zast\xE1vo\u010Dka,
      hal\xF3\xF3."
    voice: {fileID: 0}
    secondsPerCharacter: 0.15
    waitForContinue: 0
    extraHoldTime: 0
  - text: "No pozri sa on mi tu norm\xE1lne zaspal."
    voice: {fileID: 0}
    secondsPerCharacter: 0.05
    waitForContinue: 0
    extraHoldTime: 0
  - text: "Kristu\u0161\xE1ka s t\xFDmi mlad\xFDmi, to je neskuto\u010Dn\xE9."
    voice: {fileID: 0}
    secondsPerCharacter: 0.05
    waitForContinue: 0
    extraHoldTime: 0
  - text: "Mlad\xFD ! Hal\xF3\xF3 vystupova\u0165 kone\u010Dn\xE1 !"
    voice: {fileID: 0}
    secondsPerCharacter: 0.05
    waitForContinue: 0
    extraHoldTime: 0
