  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c48af4535d9ee214aaacd887fbd8bde0, type: 3}
  m_Name: ShopAssistantFirstDialogue
  m_EditorClassIdentifier: 
  playOnlyOnce: 1
  hasPlayed: 1
  lines:
  - text: "Obchodn\xEDk: Vitaj mlad\xFD, nak\xFAp \u010Do potrebuje\u0161, \xE1\xE1nou."
    voice: {fileID: 8300000, guid: d07d75e7a3e23f943a0af2ef975a3edd, type: 3}
    secondsPerCharacter: 0.1
    waitForContinue: 0
    extraHoldTime: 2
  - text: "Zd\xE1\u0161 sa mi nejak povedom\xFD..., star\xFD hor\xE1r mal tie\u017E
      tak\xFA divn\xFA tv\xE1r ako ty."
    voice: {fileID: 8300000, guid: 69b689b2548da0349b9377b67431fe26, type: 3}
    secondsPerCharacter: 0.1
    waitForContinue: 0
    extraHoldTime: 0
  - text: "To bol narozdiel od teba chlap, aj si vypi\u0165 vedel, aj ved\u013Ea
      obchodu zbo\u017Eie pred\xE1va\u0165 vedel."
    voice: {fileID: 0}
    secondsPerCharacter: 0.1
    waitForContinue: 0
    extraHoldTime: 0
  - text: "Aj si r\xE1d zanad\xE1val ale pobo\u017En\xFD to bol \u010Dlovek, do kostola
      chodil ka\u017Ed\xFA nede\u013Eu."
    voice: {fileID: 0}
    secondsPerCharacter: 0.1
    waitForContinue: 0
    extraHoldTime: 0
  - text: "Len ten alkohol osudn\xFDm sa mu stal, ke\u010F na traktore prevr\xE1til
      sa, s\xE1m."
    voice: {fileID: 0}
    secondsPerCharacter: 0.1
    waitForContinue: 0
    extraHoldTime: 0
  - text: "Ak chce\u0161 zastav sa u Feriho ten \u0165a hod\xED domov."
    voice: {fileID: 0}
    secondsPerCharacter: 0.1
    waitForContinue: 0
    extraHoldTime: 0
  - text: 
    voice: {fileID: 0}
    secondsPerCharacter: 0.1
    waitForContinue: 0
    extraHoldTime: 0
